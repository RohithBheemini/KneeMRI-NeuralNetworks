# ==========================================
# KneeMRI-AAN .gitignore
# ==========================================

# 1. Raw Volumetric Medical Imaging Dataset (Excluded due to GitHub size limits: 3.7GB compressed, 6.2GB uncompressed)
# Full dataset can be downloaded from Zenodo (DOI: 10.5281/zenodo.2631264)
volumetric_data/
volumetric_data.7z
*.7z
*.zip
*.tar
*.tar.gz

# 2. Large Epoch Checkpoints (>100MB exceeds GitHub hard push limits)
# We track the final trained production model: checkpoints/best_dual_stream_resnet.pt (45.8 MB)
checkpoints/*.pth
checkpoints/*_checkpoint.pth
checkpoints/*_best_model.pth

# 3. Python, Jupyter & OS Caches
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
scratch/
test_out.pptx

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
